# Stackforge public config. Copy to .env.local. Do not commit real secrets.

# Browser-safe Supabase config. Required for auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site. Production host is https://stackforge.iquee.tech
NEXT_PUBLIC_SITE_URL=https://stackforge.iquee.tech

# Server-only. Never prefix with NEXT_PUBLIC_ and never import in client code.
# The Next.js app does not use this key; RLS stays in force for the anon client.
SUPABASE_SERVICE_ROLE_KEY=

# Local UI preview when Supabase keys are empty. Ignored in production builds.
# STACKFORGE_PREVIEW=1
