# Copy to .env.local for local development and to .env on the server.
# .env and .env.local are gitignored. Do not commit real keys.

# Public Supabase project URL. Safe to expose to the browser.
# Project ref: moqlrespnizjxnybdcc
NEXT_PUBLIC_SUPABASE_URL=https://moqlrespnizjxnybdcc.supabase.co

# Public anon key. Safe to expose to the browser. Row level security still applies.
# Do not commit the real JWT. Copy it into .env.local from the team share.
# Before using it, decode the payload and confirm "ref" is moqlrespnizjxnybdcc.
# A mismatched ref is ignored by the app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin of the Next.js app.
NEXT_PUBLIC_SITE_URL=https://stackforge.iquee.tech
NEXT_PUBLIC_APP_URL=https://stackforge.iquee.tech

# Server-only. Bypasses row level security.
# Do not prefix with NEXT_PUBLIC_. Do not import from client components,
# and do not print it in logs or ship it in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Local UI preview when the anon key is empty. Ignored in production builds.
# STACKFORGE_PREVIEW=1
